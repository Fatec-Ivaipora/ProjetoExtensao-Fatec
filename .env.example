# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local nunca é commitado (veja .gitignore).

# --- Firebase (client SDK) — público, vai pro bundle do site ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin SDK (só usado nas serverless functions em api/) ---
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# UID da conta de admin no Firebase Authentication (Console > Authentication > Users)
ADMIN_UID=

# --- Vercel Blob (upload de arquivos) ---
# Preenchido automaticamente pela Vercel quando o Blob Store é conectado ao projeto.
BLOB_READ_WRITE_TOKEN=
